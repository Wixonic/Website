{% extends "main.njk" %}

{% block head %}
<link rel="stylesheet" href="/index.css" />
{% endblock %}

{% block bodyAttributes %} is-one-page-website="true" {% endblock %}

{% block content %}

<main>

	<div class="path"></div>

	<div class="canvas"></div>

	<div class="bar">

		<div class="toolbox">

			<div class="name"></div>

			<div class="select files"></div>

			<div class="toolbox">

				<button class="website">

					<span class="shadow"></span>
					<span class="edge"></span>
					<span class="content">Website</span>

				</button>

				<button class="download">

					<span class="shadow"></span>
					<span class="edge"></span>
					<span class="content">Download</span>

				</button>

			</div>

		</div>

		<div class="description"></div>

		<div class="details"></div>

	</div>

</main>

{% endblock %}