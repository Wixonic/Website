{% extends "main.njk" %}

{% block head %}
<link rel="stylesheet" href="/index.css" />
{% endblock %}

{% block bodyAttributes %} is-one-page-website="true" {% endblock %}

{% block content %}

<main>

	<div class="canvas"></div>

	<aside>

		<div class="toolbox">

			<div class="name"></div>

			<div class="select files"></div>

			<div class="toolbox">

				<button class="website">

					<span class="edge glow"></span>
					<span class="content glow">Website</span>
					<span class="shadow"></span>

				</button>

				<button class="download">

					<span class="edge glow"></span>
					<span class="content glow">Download</span>
					<span class="shadow"></span>

				</button>

			</div>

		</div>

		<div class="description"></div>

	</aside>

	<div class="details glow"></div>

</main>

{% endblock %}