rules_version = "2";

service firebase.storage {
	match /b/{bucket}/o {
		function getUserPermissions() {
			return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/permissions/storage).data;
		}

		function hasRole(role) {
			return request.auth != null && request.auth.token[role] == true;
		}

		function can(path, action) {
			return request.auth != null && path in getUserPermissions()[action];
		}

		match /knowledge/private/{privatePath=**} {
			allow read: if request.auth != null && (hasRole("admin") || can("knowledge/private/" + string(privatePath), "read"));
			allow write: if request.auth != null && (hasRole("admin") || can("knowledge/private/" + string(privatePath), "write"));
		}

		match /knowledge/{filePath=**} {
			allow read: if !string(filePath).startsWith("private/");
			allow write: if request.auth != null && (hasRole("admin") || hasRole("editor") || can("knowledge/" + string(filePath), "write"));
		}
	}
}