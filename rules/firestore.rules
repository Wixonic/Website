rules_version = "2";

service cloud.firestore {
	match /databases/{database}/documents {
		function hasRole(role) {
			return request.auth != null && role in request.auth.token && request.auth.token[role] == true;
		}

		function isValidDisplayName(name) {
			return name is string && name.matches("^[\\p{L}\\p{N}_\\- ]{4,20}$");
		}

		function isValidUserUpdate(data) {
			let keys = request.writeFields;

			return ((keys.hasAny(["displayName"]) && isValidDisplayName(data.displayName)))
				&& keys.hasOnly(["displayName"]);
		}
		
		match /users/{uid} {
			allow read: if true;
			allow update: if request.auth != null && request.auth.uid == uid && isValidUserUpdate(request.resource.data);
		}

		match /{allPaths=**} {
			allow read, write: if false;
		}
	}
}