{
	"scripts": {
		"serve": "clear; npm run testbuild && firebase emulators:start --import=\"emulator/data\" --export-on-exit",
		"prepublish": "clear; npm run build",
		"publish": "clear; firebase deploy",
		"build": "clear; rm -rf build/; npx @11ty/eleventy",
		"testbuild": "dev=true clear=true npm run build"
	},
	"dependencies": {
		"@11ty/eleventy": "^3.1.6",
		"esbuild": "^0.28.2",
		"html-minifier": "^4.0.0"
	},
	"type": "module",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
