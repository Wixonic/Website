{
	"hosting": [
		{
			"target": "root",
			"public": "./websites/root",
			"ignore": [".DS_Store"],
			"rewrites": [
				{
					"source": "**",
					"destination": "/src/main.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "max-age=7200, must-revalidate"
						}
					]
				}
			]
		},
		{
			"target": "assets",
			"public": "./websites/assets",
			"ignore": [".DS_Store"],
			"rewrites": [
				{
					"source": "**",
					"destination": "/src/main.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Access-Control-Allow-Origin",
							"value": "*"
						},
						{
							"key": "Access-Control-Allow-Methods",
							"value": "GET, OPTIONS"
						},
						{
							"key": "Cache-Control",
							"value": "max-age=43200"
						}
					]
				}
			]
		},
		{
			"target": "redirects",
			"redirects": [
				{
					"regex": "/discord(?:.*)",
					"destination": "https://discord.gg/BcXFAVKJZQ",
					"type": 301
				},
				{
					"regex": "/help(?:.*)",
					"destination": "https://discord.gg/tNfVPDmDdt",
					"type": 301
				},
				{
					"regex": "/github(?:.*)",
					"destination": "https://github.com/Wixonic",
					"type": 301
				},
				{
					"regex": "/patreon(?:.*)",
					"destination": "https://patreon.com/Wixonic",
					"type": 301
				},
				{
					"regex": "/youtube(?:.*)",
					"destination": "https://www.youtube.com/channel/UCnPN_SkWcIDNL-BjJGeDzQA",
					"type": 301
				},
				{
					"source": "**",
					"destination": "https://wixonic.fr",
					"type": 301
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "max-age=43200"
						}
					]
				}
			]
		}
	],
	"emulators": {
		"singleProjectMode": true,
		"ui": {
			"enabled": true,
			"host": "localhost",
			"port": 2000
		},
		"auth": {
			"host": "localhost",
			"port": 2001
		},
		"firestore": {
			"host": "localhost",
			"port": 2002
		},
		"hosting": {
			"host": "localhost",
			"port": 2005
		}
	},
	"firestore": {
		"rules": "./rules/firestore.rules",
		"indexes": "./rules/firestore.indexes.json"
	}
}
