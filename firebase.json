{
	"hosting": [
		{
			"target": "root",
			"public": "./build/root",
			"ignore": [
				".DS_Store"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/404.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "max-age=7200, must-revalidate"
						}
					]
				}
			]
		},
		{
			"target": "assets",
			"public": "./build/assets",
			"ignore": [
				".DS_Store"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Access-Control-Allow-Origin",
							"value": "*"
						},
						{
							"key": "Access-Control-Allow-Methods",
							"value": "GET, OPTIONS"
						},
						{
							"key": "Cache-Control",
							"value": "max-age=43200"
						}
					]
				}
			]
		},
		{
			"target": "onion",
			"public": "./build/onion",
			"ignore": [
				".DS_Store"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/404.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "max-age=7200, must-revalidate"
						}
					]
				}
			]
		},
		{
			"target": "redirects",
			"public": "./build/redirects",
			"redirects": [
				{
					"regex": "/about(?:.*)",
					"destination": "https://wixonic.fr/about",
					"type": 301
				},
				{
					"regex": "/contact(?:.*)",
					"destination": "https://wixonic.fr/help",
					"type": 301
				},
				{
					"regex": "/discord(?:.*)",
					"destination": "https://discord.gg/BcXFAVKJZQ",
					"type": 301
				},
				{
					"regex": "/help/discord(?:.*)",
					"destination": "https://discord.gg/wVHSFqG85J",
					"type": 301
				},
				{
					"regex": "/help(?:.*)",
					"destination": "https://wixonic.fr/help",
					"type": 301
				},
				{
					"regex": "/funding/discord(?:.*)",
					"destination": "https://discord.gg/2QB7QkPtrA",
					"type": 301
				},
				{
					"regex": "/funding(?:.*)",
					"destination": "https://discord.wixonic.fr/funding",
					"type": 301
				},
				{
					"regex": "/github(?:.*)",
					"destination": "https://github.com/Wixonic",
					"type": 301
				},
				{
					"regex": "/gravatar(?:.*)",
					"destination": "https://gravatar.com/wixonic12",
					"type": 301
				},
				{
					"regex": "/osu(?:.*)",
					"destination": "https://osu.ppy.sh/users/36630136",
					"type": 301
				},
				{
					"regex": "/reddit(?:.*)",
					"destination": "https://www.reddit.com/user/Wixonic12",
					"type": 301
				},
				{
					"regex": "/twitch(?:.*)",
					"destination": "https://www.twitch.tv/wixonic",
					"type": 301
				},
				{
					"regex": "/wakatime(?:.*)",
					"destination": "https://wakatime.com/@Wixonic",
					"type": 301
				},
				{
					"regex": "/youtube/secondary(?:.*)",
					"destination": "https://www.youtube.com/@WixonicClips",
					"type": 301
				},
				{
					"regex": "/youtube(?:.*)",
					"destination": "https://www.youtube.com/@Wixonic",
					"type": 301
				}
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/404.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "max-age=43200"
						}
					]
				}
			]
		},
		{
			"target": "status",
			"public": "./build/status",
			"ignore": [
				".DS_Store"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/404.html"
				}
			],
			"headers": [
				{
					"source": "**",
					"headers": [
						{
							"key": "Cache-Control",
							"value": "max-age=7200, must-revalidate"
						}
					]
				}
			]
		}
	],
	"emulators": {
		"singleProjectMode": true,
		"ui": {
			"enabled": true,
			"host": "127.0.0.1",
			"port": 2000
		},
		"firestore": {
			"host": "127.0.0.1",
			"port": 2002
		},
		"hosting": {
			"host": "127.0.0.1",
			"port": 2005
		}
	},
	"firestore": {
		"rules": "./rules/firestore.rules",
		"indexes": "./rules/firestore.indexes.json"
	}
}